  "query": "\n        UPDATE dining_tables AS t\n        SET position = o.n::int, updated_at = now()\n        FROM unnest($1::uuid[]) WITH ORDINALITY AS o(id, n)\n        WHERE t.id = o.id\n        RETURNING t.id, t.section_id, t.label, t.seats, t.position, t.version, t.archived_at\n        ",
