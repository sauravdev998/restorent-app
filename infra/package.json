{
  "name": "infra",
  "private": true,
  "version": "0.0.0",
  "bin": {
    "infra": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "format": "prettier --write \"{bin,lib}/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"{bin,lib}/**/*.ts\" \"*.json\""
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1034.0",
    "aws-cdk-lib": "^2.230.0",
    "constructs": "^10.4.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.7",
    "typescript": "~6.0.2"
  }
}
