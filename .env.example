# Copy to .env for local development. Never commit .env.
# The API reads every one of these at boot into a typed struct and refuses to
# start if any is missing or malformed (see api/src/infrastructure/config.rs).

# What the running API connects as. A least privilege role that owns nothing,
# so row level security applies to it. Also what the SQLx query! macros check
# your SQL against at compile time.
DATABASE_URL=postgres://app_api:local_dev_only@localhost:5434/restaurant

# What migrations run as. Owns the schema, so it is deliberately NOT the role
# the API uses. Only sqlx-cli ever sees this.
OWNER_DATABASE_URL=postgres://restaurant_owner:local_dev_only@localhost:5434/restaurant

# Where the API listens.
APP_HOST=127.0.0.1
APP_PORT=8080

# development | production. Controls log format: pretty locally, JSON in production.
APP_ENV=development

# Connection pool ceiling. The LISTEN connection is taken from outside this pool.
DATABASE_MAX_CONNECTIONS=10

# What `pnpm db:seed` creates, and what to sign in with locally. These are in
# the repository, so they are public: the seed binary refuses to run anywhere
# but development for exactly that reason.
#
# One restaurant ("The Development Kitchen", in India, so rupees), one room with
# four tables, two menu categories holding six dishes with one of them marked
# unavailable, and these three accounts:
#
#   admin   admin@example.test    development-only-password
#   waiter  waiter@example.test   development-only-password
#   chef    chef@example.test     development-only-password
#
# Sign in as the waiter on one device and the chef on another to watch the whole
# order thread work. Running the seed twice changes nothing.
#
# They are constants in api/src/bin/seed.rs rather than variables, because a
# seeded password read from the environment is a password somebody eventually
# sets in production.

# Log filter, standard tracing syntax.
RUST_LOG=api=debug,tower_http=debug,info
