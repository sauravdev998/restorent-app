# Copy to .env for local development. Never commit .env.
# The API reads every one of these at boot into a typed struct and refuses to
# start if any is missing or malformed (see api/src/infrastructure/config.rs).

# What the running API connects as. A least privilege role that owns nothing,
# so row level security applies to it. Also what the SQLx query! macros check
# your SQL against at compile time.
DATABASE_URL=postgres://app_api:local_dev_only@localhost:5434/restaurant

# What migrations run as. Owns the schema, so it is deliberately NOT the role
# the API uses. Only sqlx-cli ever sees this.
OWNER_DATABASE_URL=postgres://restaurant_owner:local_dev_only@localhost:5434/restaurant

# Where the API listens.
APP_HOST=127.0.0.1
APP_PORT=8080

# development | production. Controls log format: pretty locally, JSON in production.
APP_ENV=development

# Connection pool ceiling. The LISTEN connection is taken from outside this pool.
DATABASE_MAX_CONNECTIONS=10

# Log filter, standard tracing syntax.
RUST_LOG=api=debug,tower_http=debug,info
