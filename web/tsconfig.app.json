{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness. The whole reason this stack is typed at both ends, so none of
       this gets relaxed without a decision. noUncheckedIndexedAccess is the one
       people are tempted to drop: it is what stops `items[0]` being treated as
       definitely present on an empty list. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Feature folders import each other through these, never through a chain of
       ../../.. that breaks the moment a file moves. Paths resolve relative to
       this file; baseUrl is deprecated in TypeScript 6 and deliberately absent. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
